# Supabase — from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Database — Supabase pooler connection string (for Drizzle ORM)
DATABASE_URL=postgresql://postgres.[ref]:[password]@[host]:[port]/postgres

# DeepSeek AI — API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Z-Pay — payment integration credentials
ZPAY_PID=your-zpay-pid
ZPAY_PKEY=your-zpay-secret-key

# Site URL — used for payment callback URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Creem — international payment (USD) for English users
# Register at https://creem.io (no business license needed)
CREEM_API_KEY=your-creem-api-key
CREEM_WEBHOOK_SECRET=your-creem-webhook-secret
NEXT_PUBLIC_CREEM_PRODUCT_ID=your-product-id
NEXT_PUBLIC_APP_URL=http://localhost:3000
